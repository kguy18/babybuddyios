        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO-Kurven benötigen bestätigte Einheiten, eine Referenz und eine gültige Altersgrundlage. Prüfe die Wachstumseinstellungen."
          }
        }
      }
    },
    "WHO length references use recumbent length through day 730 and standing height from day 731. Enable length references only when recorded measurements follow that method.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO length references use recumbent length through day 730 and standing height from day 731. Enable length references only when recorded measurements follow that method."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO-Längenreferenzen verwenden bis Tag 730 die im Liegen gemessene Länge und ab Tag 731 die im Stehen gemessene Größe. Aktiviere diese Referenzen nur, wenn die Einträge so gemessen wurden."
          }
        }
      }
    },
