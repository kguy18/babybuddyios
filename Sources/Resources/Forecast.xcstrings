            "state": "translated",
            "value": "Show activity estimates"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitätsschätzungen anzeigen"
          }
        }
      }
    },
    "Similar intervals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar intervals"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Abstände"
          }
        }
      }
    },
    "The usual window has passed. There is no current estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The usual window has passed. There is no current estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bisher übliche Zeitraum ist vorbei. Es gibt keine aktuelle Schätzung."
          }
        }
      }
    },
    "Uses the last 14 days and up to ten similar intervals near the same time of day. At least four intervals across three days are required. Sparse, irregular, incomplete or stale data produces no estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the last 14 days and up to ten similar intervals near the same time of day. At least four intervals across three days are required. Sparse, irregular, incomplete or stale data produces no estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die letzten 14 Tage und bis zu zehn ähnliche Abstände zu einer vergleichbaren Tageszeit. Erforderlich sind mindestens vier Abstände an drei Tagen. Bei zu wenigen, unregelmäßigen, unvollständigen oder veralteten Daten wird keine Schätzung angezeigt."
          }
        }
      }
    },
    "Usual nap length": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usual nap length"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher übliche Schlafdauer"
          }
        }
      }
    },
    "What's next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's next"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kommt als Nächstes?"
          }
        }
      }
