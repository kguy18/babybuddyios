// Template for build-time secrets.
//
// Copy this file to `Secrets.xcconfig` in the same folder and fill in your
// values. `Secrets.xcconfig` is gitignored and must never be committed.
//
// Leave a value blank (or skip creating the file entirely) to build with that
// service disabled — the default for the open-source repo.
TELEMETRYDECK_APP_ID = YOUR-TELEMETRYDECK-APP-ID

// Optional salt for the anonymous per-device user hash. Any random string works;
// generate one with `openssl rand -hex 24`. Blank = unsalted (still anonymous).
TELEMETRYDECK_SALT = YOUR-TELEMETRYDECK-SALT

// RevenueCat public Apple SDK key (Project → API keys in the RevenueCat
// dashboard; begins with `appl_`). Blank = in-app purchases disabled.
REVENUECAT_API_KEY = YOUR-REVENUECAT-PUBLIC-SDK-KEY
