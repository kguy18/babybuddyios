          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat %1$@ die Farbe %2$@ zugewiesen. Andere Geräte zeigen diese Farbe weiterhin an. Ändere die Farbe auf jedem Gerät, um sie anzugleichen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor deu a %1$@ a cor %2$@, e os outros celulares continuam mostrando assim. Para igualar, mude em cada celular."
          }
        }
      }
