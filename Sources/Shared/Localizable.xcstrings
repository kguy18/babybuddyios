    "Baby Buddy Companion has been there for every one of them. It's free for everyone — supporters are what keep it that way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy Companion has been there for every one of them. It's free for everyone — supporters are what keep it that way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy Companion war bei jeder dabei. Die App ist für alle kostenlos. Freiwillige Unterstützung sorgt dafür, dass das so bleibt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Baby Buddy Companion esteve presente em cada um deles. Ele é gratuito para todo mundo, e são os apoiadores que mantêm isso assim."
          }
        }
      }
    },
