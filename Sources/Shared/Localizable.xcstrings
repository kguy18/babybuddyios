    "Get a notification when a timer runs longer than expected, so a forgotten one doesn't file a bogus record. Tap it to open Stop Timer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification when a timer runs longer than expected, so a forgotten one doesn't file a bogus record. Tap it to open Stop Timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Mitteilung, wenn ein Timer länger als erwartet läuft, damit ein vergessener Timer keinen falschen Eintrag erzeugt. Tippe darauf, um ihn zu stoppen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba uma notificação quando um cronômetro rodar mais que o esperado, para que um esquecido não gere um registro errado. Toque nela para abrir Parar cronômetro."
          }
        }
      }
    },
