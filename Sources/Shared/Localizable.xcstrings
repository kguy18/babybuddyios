    "Thank you for chipping in — it keeps Baby Buddy Companion free for everyone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for chipping in — it keeps Baby Buddy Companion free for everyone."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Beitrag hilft, Baby Buddy Companion für alle kostenlos zu halten. Vielen Dank!"
          }
        }
      }
    },
    "That QR code isn't a Baby Buddy login code. Open User → Add a Device on your server to show it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That QR code isn't a Baby Buddy login code. Open User → Add a Device on your server to show it."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser QR-Code ist kein Baby-Buddy-Anmeldecode. Öffne auf deinem Server „Benutzer → Gerät hinzufügen“ (User → Add a Device), um ihn anzuzeigen."
          }
        }
      }
    },
    "That code didn't work. Check the latest email, or send a new code.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't work. Check the latest email, or send a new code."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code hat nicht funktioniert. Prüfe die neueste E-Mail oder fordere einen neuen Code an."
          }
        }
      }
    },
    "That date is in the future — Baby Buddy only accepts dates up to today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That date is in the future — Baby Buddy only accepts dates up to today."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Datum liegt in der Zukunft. Baby Buddy akzeptiert nur Daten bis heute."
          }
        }
      }
    },
    "That doesn't look like a valid server address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a valid server address."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer gültigen Serveradresse aus."
          }
        }
      }
    },
    "That email and password don't match.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email and password don't match."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adresse und Passwort stimmen nicht überein."
          }
        }
      }
    },
    "That isn't a number Baby Buddy can read. Use digits, like 90 or 4.5.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That isn't a number Baby Buddy can read. Use digits, like 90 or 4.5."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy kann diese Zahl nicht lesen. Verwende Ziffern, zum Beispiel 90 oder 4,5."
          }
        }
      }
    },
    "That record no longer exists on the server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That record no longer exists on the server."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag ist auf dem Server nicht mehr vorhanden."
          }
        }
      }
    },
    "That time is in the future — Baby Buddy only accepts times up to now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That time is in the future — Baby Buddy only accepts times up to now."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhrzeit liegt in der Zukunft. Baby Buddy akzeptiert nur Zeiten bis jetzt."
          }
        }
      }
    },
    "The Dashboard and status widget show when data was last updated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Dashboard and status widget show when data was last updated."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersicht und das Status-Widget zeigen, wann die Daten zuletzt aktualisiert wurden."
          }
        }
      }
    },
    "The activities cached on this device will be deleted. Nothing on your server changes — signing back in downloads them again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The activities cached on this device will be deleted. Nothing on your server changes — signing back in downloads them again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Gerät zwischengespeicherten Aktivitäten werden gelöscht. Auf deinem Server ändert sich nichts. Nach der erneuten Anmeldung werden sie wieder heruntergeladen."
          }
        }
      }
    },
    "The app sets %@ itself, so it can't be a custom header.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app sets %@ itself, so it can't be a custom header."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App setzt %@ selbst. Dieser Header kann nicht benutzerdefiniert sein."
          }
        }
      }
    },
    "The code fills in from Mail and signs you in on its own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code fills in from Mail and signs you in on its own."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code wird aus Mail übernommen und meldet dich automatisch an."
          }
        }
      }
    },
    "The editor tells you when an entry overlaps one already logged, before you save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor tells you when an entry overlaps one already logged, before you save."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor warnt dich vor dem Speichern, wenn sich ein Eintrag mit einem vorhandenen überschneidet."
          }
        }
      }
    },
    "The gate in front of %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gate in front of %@"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugangskontrolle vor %@"
          }
        }
      }
    },
    "The photo is removed from this device. Any photo already on the server is kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is removed from this device. Any photo already on the server is kept."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto wird von diesem Gerät entfernt. Ein bereits auf dem Server gespeichertes Foto bleibt erhalten."
          }
        }
      }
    },
    "The record stays on the server and reappears on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record stays on the server and reappears on this device."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag bleibt auf dem Server und erscheint wieder auf diesem Gerät."
          }
        }
      }
    },
    "The server address is not valid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address is not valid."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serveradresse ist ungültig."
          }
        }
      }
    },
    "The server answered with a web page instead of the Baby Buddy API. If a login proxy such as Authentik or Authelia is in front of it, let /api/ and /media/ through.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered with a web page instead of the Baby Buddy API. If a login proxy such as Authentik or Authelia is in front of it, let /api/ and /media/ through."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit einer Webseite statt mit der Baby-Buddy-API geantwortet. Bei einem vorgeschalteten Anmelde-Proxy wie Authentik oder Authelia gib /api/ und /media/ frei."
          }
        }
      }
    },
    "The server rejected the request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the request."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage abgelehnt."
          }
        }
      }
    },
    "The server took too long to respond.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to respond."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht rechtzeitig geantwortet."
          }
        }
      }
    },
    "The server's security certificate wasn't accepted. A self-signed certificate has to be trusted on this device first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's security certificate wasn't accepted. A self-signed certificate has to be trusted on this device first."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat des Servers wurde nicht akzeptiert. Ein selbstsigniertes Zertifikat muss zuerst auf diesem Gerät als vertrauenswürdig eingestuft werden."
          }
        }
      }
    },
    "The start time is after the end time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start time is after the end time."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Startzeit liegt nach der Endzeit."
          }
        }
      }
    },
    "The timer counts up from its start until you stop it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer counts up from its start until you stop it."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer zählt ab seiner Startzeit, bis du ihn stoppst."
          }
        }
      }
    },
    "The timer stops when you tap Stop, not when you save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer stops when you tap Stop, not when you save."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer stoppt beim Tippen auf „Stoppen“, nicht erst beim Speichern."
          }
        }
      }
    },
    "The timer this was logged from no longer exists on the server. It may already have been saved from another device — check before creating it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer this was logged from no longer exists on the server. It may already have been saved from another device — check before creating it again."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer zu diesem Eintrag ist auf dem Server nicht mehr vorhanden. Möglicherweise wurde er bereits auf einem anderen Gerät gespeichert. Prüfe dies, bevor du ihn erneut erstellst."
          }
        }
      }
    },
    "The value for %@ can't contain a line break or control character.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value for %@ can't contain a line break or control character."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert für %@ darf keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        }
      }
    },
    "The whole app is free, and stays that way. A one-time tip supports development — thank you either way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole app is free, and stays that way. A one-time tip supports development — thank you either way."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte App ist und bleibt kostenlos. Ein einmaliger Beitrag unterstützt die Entwicklung. Danke, dass du die App nutzt!"
          }
        }
      }
    },
    "Themes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Themes"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Designs"
          }
        }
      }
    },
    "There's no Baby Buddy API at that address. Check the server URL.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no Baby Buddy API at that address. Check the server URL."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Adresse ist keine Baby-Buddy-API erreichbar. Prüfe die Server-URL."
          }
        }
      }
    },
    "This %@ never reached the server, so discarding it deletes it from this device too.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %@ never reached the server, so discarding it deletes it from this device too."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag (%@) hat den Server nie erreicht. Beim Verwerfen wird er auch von diesem Gerät gelöscht."
          }
        }
      }
    },
    "This %@ was deleted on the server while you had local changes here. Keep your version to restore it, or discard it to accept the deletion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %@ was deleted on the server while you had local changes here. Keep your version to restore it, or discard it to accept the deletion."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag (%@) wurde auf dem Server gelöscht, während du ihn hier geändert hast. Behalte deine Version, um ihn wiederherzustellen, oder verwirf sie, um die Löschung zu übernehmen."
          }
        }
      }
    },
    "This app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app"
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App"
          }
        }
      }
    },
    "This app is an independent client not affiliated with Baby Buddy the open source server project, so if you have server-side issues please open a ticket on [their GitHub](https://github.com/babybuddy/babybuddy).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is an independent client not affiliated with Baby Buddy the open source server project, so if you have server-side issues please open a ticket on [their GitHub](https://github.com/babybuddy/babybuddy)."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App ist ein unabhängiger Client und gehört nicht zum Open-Source-Serverprojekt Baby Buddy. Bei Problemen mit dem Server öffne bitte ein Ticket auf [dessen GitHub-Seite](https://github.com/babybuddy/babybuddy)."
          }
        }
      }
    },
    "This child's record on the server is missing something the photo upload needs. Refresh, then tap Retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
