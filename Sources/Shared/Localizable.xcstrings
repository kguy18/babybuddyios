    },
    "A reading at or over this line counts as a fever. It brings up the banner on Home and keeps temperature checks coming.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reading at or over this line counts as a fever. It brings up the banner on Home and keeps temperature checks coming."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Messwert ab dieser Grenze gilt als Fieber. Er löst den Hinweis in der Übersicht aus und hält die Temperaturerinnerungen aktiv."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma medição igual ou acima deste limite conta como febre. Ela mostra o aviso no Início e mantém os lembretes de temperatura ativos."
          }
        }
      }
    },
    "A reminder when a timer runs too long. Turn it on in Settings → Notifications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reminder when a timer runs too long. Turn it on in Settings → Notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Erinnerung, wenn ein Timer zu lange läuft. Aktiviere sie unter Einstellungen → Mitteilungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete quando um cronômetro passa do tempo. Ative em Ajustes → Notificações."
          }
        }
      }
    },
    "A timer nags once. The alert stays until the timer stops.": {
      "extractionState": "manual",
