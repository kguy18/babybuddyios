    "Displayed windows summarize past entries. They are not a prescribed schedule, a probability, or a prediction validated for medical use.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displayed windows summarize past entries. They are not a prescribed schedule, a probability, or a prediction validated for medical use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angezeigten Zeiträume fassen frühere Einträge zusammen. Sie sind kein vorgegebener Zeitplan, keine Wahrscheinlichkeit und keine für medizinische Zwecke geprüfte Prognose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os intervalos exibidos resumem registros anteriores. Não são uma rotina prescrita, uma probabilidade nem uma previsão validada para uso médico."
          }
        }
      }
    },
