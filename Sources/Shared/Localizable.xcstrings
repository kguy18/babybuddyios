    "Every feature is free — no locks, no subscriptions. If the app has earned a place in your routine, you can chip in to keep it growing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every feature is free — no locks, no subscriptions. If the app has earned a place in your routine, you can chip in to keep it growing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Funktionen sind kostenlos, ohne Einschränkungen oder Abos. Wenn die App dir im Alltag hilft, kannst du ihre Weiterentwicklung mit einem Beitrag unterstützen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os recursos são gratuitos, sem bloqueios e sem assinatura. Se o app ganhou um lugar na sua rotina, você pode contribuir para ele continuar crescendo."
          }
        }
      }
    },
    "Every feature is free, for everyone, and always will be. If the app has earned a place in your day, a one-time tip helps it keep growing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every feature is free, for everyone, and always will be. If the app has earned a place in your day, a one-time tip helps it keep growing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Funktionen sind für alle kostenlos und werden es bleiben. Wenn die App dir im Alltag hilft, unterstützt ein einmaliger Beitrag ihre Weiterentwicklung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os recursos são gratuitos, para todo mundo, e sempre vão ser. Se o app ganhou um lugar no seu dia, uma contribuição única ajuda ele a continuar crescendo."
          }
        }
      }
    },
    "Every new record shows Undo for five seconds, so a mis-tap is one tap to fix.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every new record shows Undo for five seconds, so a mis-tap is one tap to fix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder neue Eintrag zeigt fünf Sekunden lang „Rückgängig“. So lässt sich ein Versehen sofort korrigieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo registro novo mostra Desfazer por cinco segundos, então um toque errado se corrige com outro toque."
          }
        }
      }
    },
    "Every reading and dose stays in Baby Buddy. Home goes back to its usual layout.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every reading and dose stays in Baby Buddy. Home goes back to its usual layout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Messwerte und Gaben bleiben in Baby Buddy. Die Übersicht zeigt wieder die gewohnte Ansicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as medições e doses continuam no Baby Buddy. O Início volta ao layout de sempre."
          }
        }
      }
    },
    "Every temperature as a curve, with a mark at each medication dose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every temperature as a curve, with a mark at each medication dose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Temperaturen als Kurve, mit einer Markierung bei jeder Medikamentengabe."
          }
        },
        "pt-BR": {
