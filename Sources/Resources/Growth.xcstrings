    "Lines connect recorded measurements. Days without measurements are not zero. WHO curves show P3, P15, P50, P85 and P97 for ages 0–1856 days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lines connect recorded measurements. Days without measurements are not zero. WHO curves show P3, P15, P50, P85 and P97 for ages 0–1856 days."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien verbinden erfasste Messwerte. Tage ohne Messung entsprechen nicht null. WHO-Kurven zeigen P3, P15, P50, P85 und P97 für ein Alter von 0–1856 Tagen."
          }
        }
      }
    },
