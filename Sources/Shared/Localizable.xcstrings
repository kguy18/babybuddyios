    "The photo is removed from this device. Any photo already on the server is kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo is removed from this device. Any photo already on the server is kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto wird von diesem Gerät entfernt. Ein bereits auf dem Server gespeichertes Foto bleibt erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A foto é removida deste dispositivo. Uma foto que já esteja no servidor é mantida."
          }
        }
      }
    },
    "The record stays on the server and reappears on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The record stays on the server and reappears on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag bleibt auf dem Server und erscheint wieder auf diesem Gerät."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro continua no servidor e volta a aparecer neste dispositivo."
          }
        }
      }
    },
    "The server address is not valid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address is not valid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serveradresse ist ungültig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço do servidor não é válido."
          }
        }
      }
    },
    "The server answered with a web page instead of the Baby Buddy API. If a login proxy such as Authentik or Authelia is in front of it, let /api/ and /media/ through.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered with a web page instead of the Baby Buddy API. If a login proxy such as Authentik or Authelia is in front of it, let /api/ and /media/ through."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit einer Webseite statt mit der Baby-Buddy-API geantwortet. Bei einem vorgeschalteten Anmelde-Proxy wie Authentik oder Authelia gib /api/ und /media/ frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu com uma página web em vez da API do Baby Buddy. Se houver um proxy de login como Authentik ou Authelia na frente dele, libere /api/ e /media/."
          }
        }
      }
    },
    "The server rejected the request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage abgelehnt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou a requisição."
          }
        }
      }
    },
    "The server took too long to respond.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server took too long to respond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat nicht rechtzeitig geantwortet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor demorou demais para responder."
          }
        }
      }
    },
    "The server's security certificate wasn't accepted. A self-signed certificate has to be trusted on this device first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's security certificate wasn't accepted. A self-signed certificate has to be trusted on this device first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat des Servers wurde nicht akzeptiert. Ein selbstsigniertes Zertifikat muss zuerst auf diesem Gerät als vertrauenswürdig eingestuft werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado de segurança do servidor não foi aceito. Um certificado autoassinado precisa ser marcado como confiável neste dispositivo primeiro."
          }
        }
      }
    },
    "The start time is after the end time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start time is after the end time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Startzeit liegt nach der Endzeit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de início é depois do horário de fim."
          }
        }
      }
    },
    "The timer counts up from its start until you stop it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer counts up from its start until you stop it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer zählt ab seiner Startzeit, bis du ihn stoppst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cronômetro conta a partir do início até você parar."
          }
        }
      }
    },
    "The timer stops when you tap Stop, not when you save.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer stops when you tap Stop, not when you save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer stoppt beim Tippen auf „Stoppen“, nicht erst beim Speichern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cronômetro para quando você toca em Parar, não quando salva."
          }
        }
      }
    },
    "The timer this was logged from no longer exists on the server. It may already have been saved from another device — check before creating it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer this was logged from no longer exists on the server. It may already have been saved from another device — check before creating it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Timer zu diesem Eintrag ist auf dem Server nicht mehr vorhanden. Möglicherweise wurde er bereits auf einem anderen Gerät gespeichert. Prüfe dies, bevor du ihn erneut erstellst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cronômetro que gerou este registro não existe mais no servidor. Ele pode já ter sido salvo em outro dispositivo, então confira antes de criar de novo."
          }
        }
      }
    },
    "The value for %@ can't contain a line break or control character.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value for %@ can't contain a line break or control character."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert für %@ darf keine Zeilenumbrüche oder Steuerzeichen enthalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor de %@ não pode ter quebra de linha nem caractere de controle."
          }
        }
      }
    },
    "The whole app is free, and stays that way. A one-time tip supports development — thank you either way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole app is free, and stays that way. A one-time tip supports development — thank you either way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte App ist und bleibt kostenlos. Ein einmaliger Beitrag unterstützt die Entwicklung. Danke, dass du die App nutzt!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app inteiro é gratuito e vai continuar assim. Uma contribuição única apoia o desenvolvimento. Obrigado de qualquer jeito."
          }
        }
      }
    },
