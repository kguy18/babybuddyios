            "state": "translated",
            "value": "Next nap"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächstes Schläfchen"
          }
        }
      }
    },
    "Optional estimates on Home and the medium status widget. They use only the selected child's cached records, without a network request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional estimates on Home and the medium status widget. They use only the selected child's cached records, without a network request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Schätzungen auf der Startseite und im mittelgroßen Status-Widget. Verwendet werden nur lokal gespeicherte Einträge des ausgewählten Kindes, ohne Netzwerkanfrage."
          }
        }
      }
    },
    "Possible wake-up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible wake-up"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögliches Aufwachen"
          }
        }
      }
    },
    "Recent intervals vary too much for a useful estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent intervals vary too much for a useful estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Abstände schwanken zu stark für eine hilfreiche Schätzung."
          }
        }
      }
    },
    "Refresh your records before using estimates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh your records before using estimates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere die Einträge, bevor du Schätzungen verwendest."
          }
        }
      }
    },
    "Show activity estimates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
