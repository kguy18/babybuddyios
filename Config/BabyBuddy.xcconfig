// Build configuration for the BabyBuddy app target.
//
// The TelemetryDeck App ID is injected here and surfaced to the app via the
// `TelemetryDeckAppID` Info.plist key. The public repository ships it EMPTY on
// purpose: open-source and forked builds must never send analytics to the
// maintainer's TelemetryDeck account. Analytics only run when this value is
// non-empty (see Sources/Analytics/Analytics.swift).
//
// To enable analytics in your own build, copy `Secrets.example.xcconfig` to
// `Secrets.xcconfig` (same folder) and set your App ID there. `Secrets.xcconfig`
// is gitignored and overrides the empty default below.
TELEMETRYDECK_APP_ID =

// Optional TelemetryDeck hashing salt, injected via the `TelemetryDeckSalt`
// Info.plist key. When set, the anonymous per-device user hash is salted so it
// can't be reversed from a known device identifier. Ships EMPTY in the public
// repo (forked builds send nothing anyway); set the real salt in
// `Secrets.xcconfig` so it stays out of the public source.
TELEMETRYDECK_SALT =

// RevenueCat public Apple SDK key (begins with `appl_`), injected into the
// `RevenueCatAPIKey` Info.plist key. Ships EMPTY in the public repo: in-app
// purchases only initialize when this is non-empty (see
// Sources/Purchases/Subscriptions.swift). Set it in `Secrets.xcconfig`.
REVENUECAT_API_KEY =

// Optional, gitignored override (App Store / private builds). Missing = no-op.
#include? "Secrets.xcconfig"
