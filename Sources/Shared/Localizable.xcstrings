    "Drag to change the order on Home. With every tile off, Home leaves out Today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to change the order on Home. With every tile off, Home leaves out Today."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe die Kacheln in die gewünschte Reihenfolge für die Übersicht. Wenn alle ausgeschaltet sind, wird „Heute“ ausgeblendet."
          }
        }
      }
    },
