    "An activity is in progress or waiting to be logged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An activity is in progress or waiting to be logged."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aktivität läuft oder muss noch gespeichert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma atividade está em andamento ou aguardando registro."
          }
        }
      }
    },
    "Based on logged routines, not your baby's current needs. Follow your baby's cues and your care plan; do not wait for an estimate to feed or check a diaper.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on logged routines, not your baby's current needs. Follow your baby's cues and your care plan; do not wait for an estimate to feed or check a diaper."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schätzung beruht auf protokollierten Abläufen und kennt die aktuellen Bedürfnisse deines Babys nicht. Beachte seine Signale und euren Betreuungsplan. Warte zum Füttern oder Prüfen der Windel nicht auf eine Schätzung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nas rotinas registradas, não nas necessidades atuais do seu bebê. Siga os sinais do seu bebê e o seu plano de cuidados; não espere uma estimativa para alimentar ou verificar a fralda."
          }
        }
      }
    },
    "Check incomplete entries or sync conflicts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incomplete entries or sync conflicts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe unvollständige Einträge oder Synchronisierungskonflikte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique registros incompletos ou conflitos de sincronização."
          }
        }
      }
    },
