    "The API does not provide reference sex or gestational age. Choose the appropriate reference and age basis with your care team. Nothing is inferred.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API does not provide reference sex or gestational age. Choose the appropriate reference and age basis with your care team. Nothing is inferred."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die API liefert weder das Referenzgeschlecht noch die Schwangerschaftsdauer. Stimme die passende Referenz und Altersgrundlage mit deinem Behandlungsteam ab. Es werden keine Angaben geschätzt."
          }
        }
      }
