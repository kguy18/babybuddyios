          "stringUnit": {
            "state": "translated",
            "value": "Gerätemodell, iOS-Version und App-Version zur Untersuchung hinzufügen? Weitere Daten werden nicht geteilt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexar o modelo do dispositivo, a versão do iOS e a versão do app para ajudar na investigação? Nada mais é compartilhado."
          }
        }
      }
    },
    "Authelia answered instead of Baby Buddy. Add an access control rule that bypasses ^/api/.* and ^/media/.* for this server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authelia answered instead of Baby Buddy. Add an access control rule that bypasses ^/api/.* and ^/media/.* for this server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authelia hat anstelle von Baby Buddy geantwortet. Ergänze für diesen Server eine Zugriffskontrollregel, die ^/api/.* und ^/media/.* freigibt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Authelia respondeu no lugar do Baby Buddy. Adicione uma regra de controle de acesso que libere ^/api/.* e ^/media/.* para este servidor."
          }
        }
      }
    },
    "Authentik answered instead of Baby Buddy. In its proxy provider, add ^/api/.* and ^/media/.* to Unauthenticated Paths.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentik answered instead of Baby Buddy. In its proxy provider, add ^/api/.* and ^/media/.* to Unauthenticated Paths."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentik hat anstelle von Baby Buddy geantwortet. Ergänze ^/api/.* und ^/media/.* unter „Unauthenticated Paths“ im Proxy-Provider."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Authentik respondeu no lugar do Baby Buddy. No proxy provider dele, adicione ^/api/.* e ^/media/.* em Unauthenticated Paths."
          }
        }
      }
    },
    "Authorization carries your API token, so it can't be a custom header.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization carries your API token, so it can't be a custom header."
