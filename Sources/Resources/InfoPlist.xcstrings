{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy uses Face ID to keep your baby's data private."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy verwendet Face ID, um die Daten deines Babys zu schützen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Baby Buddy usa o Face ID para manter os dados do seu bebê privados."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy uses the camera to scan the login QR code from your server's Add a Device page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baby Buddy verwendet die Kamera, um den Anmelde-QR-Code auf der Seite „Gerät hinzufügen“ deines Servers zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Baby Buddy usa a câmera para escanear o QR code de login da página Add a Device do seu servidor."
          }
        }
      }
    }
  },
  "version": "1.0"
}
