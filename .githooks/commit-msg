#!/bin/sh
# Rejects attribution trailers and em dashes in commit messages.
# Activate once per clone: git config core.hooksPath .githooks
"$(git rev-parse --show-toplevel)/scripts/check-attribution.sh" "$1" || exit 1
if grep -v '^#' "$1" | grep -q '—'; then
  echo "commit-msg: no em dashes. Use a period or a comma." >&2
  exit 1
fi
