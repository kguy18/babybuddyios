    "Optional estimates on Home and the medium status widget. They use only the selected child's cached records, without a network request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional estimates on Home and the medium status widget. They use only the selected child's cached records, without a network request."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Schätzungen auf der Startseite und im mittelgroßen Status-Widget. Verwendet werden nur lokal gespeicherte Einträge des ausgewählten Kindes, ohne Netzwerkanfrage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativas opcionais no Início e no widget médio de status. Usam apenas os registros em cache da criança selecionada, sem nenhuma solicitação de rede."
          }
        }
      }
    },
    "Possible wake-up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible wake-up"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögliches Aufwachen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Possível despertar"
          }
        }
      }
    },
    "Show activity estimates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show activity estimates"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitätsschätzungen anzeigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar estimativas de atividades"
          }
        }
      }
    },
    "Uses the last 14 days and up to ten similar intervals near the same time of day. At least four intervals across three days are required. Sparse, irregular, incomplete, or stale data produces no estimate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the last 14 days and up to ten similar intervals near the same time of day. At least four intervals across three days are required. Sparse, irregular, incomplete, or stale data produces no estimate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die letzten 14 Tage und bis zu zehn ähnliche Abstände zu einer vergleichbaren Tageszeit. Erforderlich sind mindestens vier Abstände an drei Tagen. Bei zu wenigen, unregelmäßigen, unvollständigen oder veralteten Daten wird keine Schätzung angezeigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa os últimos 14 dias e até dez intervalos semelhantes perto do mesmo horário. São necessários pelo menos quatro intervalos em três dias. Dados escassos, irregulares, incompletos ou desatualizados não geram estimativa."
          }
        }
      }
    },
    "Wakes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht auf"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acorda"
          }
        }
      }
    },
