    "Home becomes a fever dashboard: temperatures, doses, and what's due next.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home becomes a fever dashboard: temperatures, doses, and what's due next."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übersicht zeigt bei Fieber Temperaturen, Medikamentengaben und die nächsten Termine."
          }
        },
        "pt-BR": {
